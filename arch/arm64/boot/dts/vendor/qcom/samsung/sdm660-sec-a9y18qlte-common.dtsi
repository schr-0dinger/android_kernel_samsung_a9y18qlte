// SPDX-License-Identifier: GPL-2.0-only
/*
 * Parts shared by every a9y18qlte board revision.
 */

#include <dt-bindings/input/input.h>

&int_codec {
	qcom,model = "sdm660-snd-card-mtp";
	status = "okay";
};

/* Samsung changes to the qcom sdm660 files, from the 4.4 kernel */

&soc {
	qcom,msm-ssc-sensors {
		status = "ok";
		qcom,firmware-name = "adsp";
	};
};

&{/soc/qcom,icnss@18800000} {
	qcom,vdd-cx-mx-config = <800000 800000>;
};

&qcom_seecom {
	qcom,commonlib64-loaded-by-uefi;
};

&ufs1 {
	/delete-property/ spm-level;
};

/* SD card: no pull on CMD/CD, 8 mA on DATA */
&sdc1_cmd_on {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&sdc1_cmd_off {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&sdc2_data_on {
	config {
		drive-strength = <8>;
	};
};

&sdc2_cd_on {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&soc {
	/* S2DOS03 display PMIC on a GPIO I2C bus */
	i2c_22: i2c@22 {
		compatible = "i2c-gpio";
		gpios = <&tlmm 66 0	/* SDA */
			 &tlmm 70 0>;	/* SCL */
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_22_pinctrl>;

		s2dos03@60 {
			compatible = "slsi,s2dos03";
			reg = <0x60>;
			buck-ramp-up = <0>;		/* 6.25mV/us */
			buck-fpwm = <0>;		/* disabled */
			uvlo-fall-threshold = <0>;	/* 2.30V */

			regulators {
				s2dos03_l1: s2dos03-ldo1 {
					regulator-name = "s2dos03-ldo1";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					active-discharge-enable = <1>;
				};

				s2dos03_l2: s2dos03-ldo2 {
					regulator-name = "s2dos03-ldo2";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					active-discharge-enable = <1>;
				};

				s2dos03_l3: s2dos03-ldo3 {
					regulator-name = "s2dos03-ldo3";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					regulator-boot-on;
					active-discharge-enable = <1>;
				};

				s2dos03_l4: s2dos03-ldo4 {
					regulator-name = "s2dos03-ldo4";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					active-discharge-enable = <1>;
				};

				s2dos03_buck: s2dos03-buck {
					regulator-name = "s2dos03-buck";
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <2093750>;
					regulator-boot-on;
					active-discharge-enable = <1>;
				};
			};
		};
	};
};

&i2c_4 {
	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt532_ts_device";
		reg = <0x20>;
		pinctrl-names = "on_state", "off_state";
		pinctrl-0 = <&tsp_int_active>;
		pinctrl-1 = <&tsp_int_suspend>;
		zinitix,irq_gpio = <&tlmm 67 0>;
		zinitix,gpio_ldo_en;
		zinitix,regulator_avdd = "s2dos03-ldo3";
		zinitix,x_resolution = <1080>;
		zinitix,y_resolution = <2220>;
		zinitix,page_size = <128>;
		zinitix,chip_name = "ZT7548";
		zinitix,firmware_name = "tsp_zinitix/zt7548_a9y18.fw";
		zinitix,spay = "true";
		zinitix,aod = "true";
		zinitix,tclm_level = <0x02>;
		zinitix,afe_base = <0x8913>;
		zinitix,mis_cal_check = "true";
		zinitix,factory_item_version = <4>;
		clock-names = "iface_clk", "core_clk";
		clocks = <&clock_gcc GCC_BLSP1_AHB_CLK>,
			 <&clock_gcc GCC_BLSP1_QUP4_I2C_APPS_CLK>;
	};
};

&soc {
	/* Volume up and Bixby; volume down and power are PMIC PON keys */
	/delete-node/ gpio_keys;
	gpio_keys {
		compatible = "gpio-keys";
		input-name = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default &key_wink_default>;

		vol_up {
			label = "volume_up";
			gpios = <&pm660l_gpios 7 0x1>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};

		key_wink {
			label = "key_wink";
			gpios = <&pm660l_gpios 8 0x1>;
			linux,input-type = <1>;
			linux,code = <KEY_WINK>;
			wakeup-source;
			debounce-interval = <15>;
		};
	};
};

/* Charging and the fuel gauge are done by the SM5705, not the PM660 */
&pm660_pdphy {
	status = "disabled";
};

&pm660_charger {
	status = "disabled";
};

&pm660_fg {
	status = "disabled";
};

/* The PM660 BCL reads the PM660 fuel gauge, which is off */
&bcl_sensor {
	status = "disabled";
};

/*
 * The ROM ramdisk fstab mounts system and vendor (first_stage_mount).
 * Android init prefers a DT fstab, and the qcom one points vendor at
 * eMMC with A/B and AVB flags, so remove it.
 */
&firmware {
	android {
		/delete-node/ vbmeta;
		/delete-node/ fstab;
	};
};

/*
 * MTP board parts that the A9 (2018) does not have. Same as the
 * Samsung changes on 4.4: no NQ NFC on i2c_6, no SMB1351 on i2c_2.
 * The MTP camera sensors stay off until the Samsung camera DT is ported.
 */
&i2c_6 {
	status = "disabled";
};

&i2c_2 {
	/delete-node/ smb1351-charger@1d;
};

&cci {
	status = "disabled";
};
