// SPDX-License-Identifier: GPL-2.0-only
/*
 * Parts shared by every a9y18qlte board revision.
 */

&int_codec {
	qcom,model = "sdm660-snd-card-mtp";
	status = "okay";
};

/* Samsung changes to the qcom sdm660 files, from the 4.4 kernel */

&soc {
	qcom,msm-ssc-sensors {
		status = "ok";
		qcom,firmware-name = "adsp";
	};
};

&{/soc/qcom,icnss@18800000} {
	qcom,vdd-cx-mx-config = <800000 800000>;
};

&qcom_seecom {
	qcom,commonlib64-loaded-by-uefi;
};

&ufs1 {
	/delete-property/ spm-level;
};

/* SD card: no pull on CMD/CD, 8 mA on DATA */
&sdc1_cmd_on {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&sdc1_cmd_off {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&sdc2_data_on {
	config {
		drive-strength = <8>;
	};
};

&sdc2_cd_on {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&soc {
	/* S2DOS03 display PMIC on a GPIO I2C bus */
	i2c_22: i2c@22 {
		compatible = "i2c-gpio";
		gpios = <&tlmm 66 0	/* SDA */
			 &tlmm 70 0>;	/* SCL */
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_22_pinctrl>;

		s2dos03@60 {
			compatible = "slsi,s2dos03";
			reg = <0x60>;
			buck-ramp-up = <0>;		/* 6.25mV/us */
			buck-fpwm = <0>;		/* disabled */
			uvlo-fall-threshold = <0>;	/* 2.30V */

			regulators {
				s2dos03_l1: s2dos03-ldo1 {
					regulator-name = "s2dos03-ldo1";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					active-discharge-enable = <1>;
				};

				s2dos03_l2: s2dos03-ldo2 {
					regulator-name = "s2dos03-ldo2";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					active-discharge-enable = <1>;
				};

				s2dos03_l3: s2dos03-ldo3 {
					regulator-name = "s2dos03-ldo3";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					regulator-boot-on;
					active-discharge-enable = <1>;
				};

				s2dos03_l4: s2dos03-ldo4 {
					regulator-name = "s2dos03-ldo4";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <3775000>;
					active-discharge-enable = <1>;
				};

				s2dos03_buck: s2dos03-buck {
					regulator-name = "s2dos03-buck";
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <2093750>;
					regulator-boot-on;
					active-discharge-enable = <1>;
				};
			};
		};
	};
};
